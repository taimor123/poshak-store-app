NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL of poshak-store-apis (used once lib/api calls the API)
API_URL=http://localhost:4000
# Same value as INTERNAL_PROXY_SECRET in poshak-store-apis (server-only, never NEXT_PUBLIC_)
INTERNAL_PROXY_SECRET=dev-only-proxy-secret-change-me-0123456789abcdef
